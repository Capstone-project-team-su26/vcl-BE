		{
			"name": "2. Consignment List",
			"item": [
				{
					"name": "Get Consignments (Staff)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
									"    var firstOrder = jsonData.data.items[0];",
									"    pm.collectionVariables.set(\"order_id\", firstOrder.orderId);",
									"    console.log(\"Set order_id to:\", firstOrder.orderId);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/orders/consignments?pageNumber=1&pageSize=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"consignments"
							],
							"query": [
								{
									"key": "pageNumber",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "10"
								}
							]
						},
						"description": "Lấy danh sách các yêu cầu ký gửi và tự động lưu `orderId` của đơn hàng đầu tiên vào biến `order_id`"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Update Consignment Status",
			"item": [
				{
					"name": "Approve Consignment Request",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"APPROVED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/orders/consignments/{{order_id}}/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{order_id}}",
								"status"
							]
						},
						"description": "Duyệt yêu cầu ký gửi. Hệ thống sẽ tự động phát sinh mã gửi hàng và trả về trong response."
					},
					"response": []
				},
				{
					"name": "Reject Consignment Request",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"REJECTED\",\n    \"rejectionReason\": \"Hàng hóa không nằm trong danh mục ký gửi được hỗ trợ hoặc chứa chất cấm.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/orders/consignments/{{order_id}}/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{order_id}}",
								"status"
							]
						},
						"description": "Từ chối yêu cầu ký gửi kèm lý do."
					},
					"response": []
				}
			]
