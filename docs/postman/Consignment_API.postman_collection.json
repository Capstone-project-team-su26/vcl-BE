{
  "info": {
    "name": "VCL - Tao yeu cau ky gui (Consignment)",
    "description": "Test luong A1+A2: Khach hang tao yeu cau ky gui -> he thong sinh bao gia tam tinh. Bao gom login lay token, tao ky gui, xem danh sach, xac nhan bao gia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7237", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "quotationId", "value": "", "type": "string" },
    { "key": "customerEmail", "value": "buidinhtrong09122002@gmail.com", "type": "string" },
    { "key": "customerPassword", "value": "trong123", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (Customer) - lay JWT token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "    console.log('Token saved:', json.token.substring(0, 20) + '...');",
              "} else {",
              "    console.log('Khong tim thay token trong response:', JSON.stringify(json));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. Tao yeu cau ky gui (+ bao gia tu dong)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "var data = json.data;",
              "pm.test('Co orderId', function () { pm.expect(data).to.have.property('orderId'); });",
              "pm.test('Status = PENDING_REVIEW', function () { pm.expect(data.status).to.eql('PENDING_REVIEW'); });",
              "pm.test('Co bao gia tam tinh', function () { pm.expect(data.quotation).to.have.property('totalEstimatedCost'); });",
              "if (data && data.orderId) { pm.collectionVariables.set('orderId', data.orderId); }",
              "if (data && data.quotation && data.quotation.quotationId) { pm.collectionVariables.set('quotationId', data.quotation.quotationId); }",
              "console.log('orderId:', pm.collectionVariables.get('orderId'));",
              "console.log('quotationId:', pm.collectionVariables.get('quotationId'));",
              "console.log('Tong chi phi du kien:', data.quotation ? data.quotation.totalEstimatedCost : 'N/A');",
              "console.log('Warnings (hang han che):', JSON.stringify(data.warnings));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingOption\": \"Express\",\n  \"note\": \"Hang de vo, xu ly can than\",\n  \"items\": [\n    {\n      \"productName\": \"Den LED trang tri\",\n      \"productType\": \"Electronics\",\n      \"quantity\": 10,\n      \"weight\": 2.5,\n      \"width\": 20,\n      \"height\": 15,\n      \"length\": 30,\n      \"declaredValue\": 1500000,\n      \"referenceUrl\": \"https://item.taobao.com/item.htm?id=123456\",\n      \"domesticTrackingCode\": \"SF1234567890\"\n    },\n    {\n      \"productName\": \"Vo dien thoai silicon\",\n      \"productType\": \"Accessories\",\n      \"quantity\": 50,\n      \"weight\": 0.05,\n      \"width\": 8,\n      \"height\": 2,\n      \"length\": 16,\n      \"declaredValue\": 500000,\n      \"referenceUrl\": \"https://detail.1688.com/offer/987654.html\",\n      \"domesticTrackingCode\": null\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/consignments", "host": ["{{baseUrl}}"], "path": ["api", "orders", "consignments"] }
      }
    },
    {
      "name": "3. Xem danh sach yeu cau ky gui",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/orders/consignments?pageNumber=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "consignments"],
          "query": [
            { "key": "pageNumber", "value": "1" },
            { "key": "pageSize", "value": "10" },
            { "key": "status", "value": "PENDING_REVIEW", "disabled": true },
            { "key": "searchCode", "value": "", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "4. Khach xac nhan bao gia (accept)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "console.log('Order status sau khi accept:', json.data ? json.data.orderStatus : JSON.stringify(json));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/quotations/{{quotationId}}/accept",
          "host": ["{{baseUrl}}"],
          "path": ["api", "quotations", "{{quotationId}}", "accept"]
        }
      }
    },
    {
      "name": "4b. Khach huy yeu cau ky gui (cancel)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "var data = json.data;",
              "pm.test('Status = CANCELLED', function () { pm.expect(data.status).to.eql('CANCELLED'); });",
              "console.log('So bao gia bi huy theo:', data ? data.cancelledQuotations : 'N/A');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cancelReason\": \"Khach doi y, khong gui hang nua\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "consignments", "{{orderId}}", "cancel"]
        }
      }
    },
    {
      "name": "4c. (Negative) Huy lai don da huy -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "pm.test('Bao da huy truoc do', function () { pm.expect(pm.response.json().message).to.include('đã được hủy'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"cancelReason\": \"Huy lan 2\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "consignments", "{{orderId}}", "cancel"]
        }
      }
    },
    {
      "name": "4d. (Negative) Huy don khong ton tai -> 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404 Not Found', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"cancelReason\": \"Test khong ton tai\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/orders/consignments/00000000-0000-0000-0000-000000000000/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "consignments", "00000000-0000-0000-0000-000000000000", "cancel"]
        }
      }
    },
    {
      "name": "4e. (Negative) Huy khong co token -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cancelReason\": \"No token\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "consignments", "{{orderId}}", "cancel"]
        }
      }
    },
    {
      "name": "5. (Negative) Tao ky gui khong co token -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingOption\": \"Express\",\n  \"items\": [ { \"productName\": \"Test\", \"productType\": \"Test\", \"quantity\": 1 } ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/consignments", "host": ["{{baseUrl}}"], "path": ["api", "orders", "consignments"] }
      }
    },
    {
      "name": "6. (Negative) ShippingOption sai -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingOption\": \"Airplane\",\n  \"items\": [ { \"productName\": \"Test\", \"productType\": \"Test\", \"quantity\": 1 } ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/consignments", "host": ["{{baseUrl}}"], "path": ["api", "orders", "consignments"] }
      }
    }
  ]
}
