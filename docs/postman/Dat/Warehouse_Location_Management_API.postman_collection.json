{
  "info": {
    "name": "VCL - Warehouse and Location Management API (Dat)",
    "description": "Bộ API test quản lý kho và vị trí kho (Zone, Shelf, Bin).\nAPI Quản lý:\n- GET /api/warehouses\n- POST /api/warehouses\n- PUT /api/warehouses/{id}\n- DELETE /api/warehouses/{id}\n- GET /api/warehouses/{warehouseId}/locations\n- POST /api/warehouses/{warehouseId}/locations\n- PUT /api/warehouse-locations/{locationId}\n- DELETE /api/warehouse-locations/{locationId}\nAPI Nghiệp vụ:\n- GET /api/warehouses/active\n- GET /api/warehouses/{warehouseId}/locations/active",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5209", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "admin@vcl.com", "type": "string" },
    { "key": "adminPassword", "value": "Admin123", "type": "string" },
    { "key": "staffEmail", "value": "staff@employee.com", "type": "string" },
    { "key": "staffPassword", "value": "Employee123", "type": "string" },
    { "key": "warehouseId", "value": "", "type": "string" },
    { "key": "locationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0a. Seed Staff & Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/Test/seed-staff", "host": ["{{baseUrl}}"], "path": ["api", "Test", "seed-staff"] }
      }
    },
    {
      "name": "1. Login (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('adminToken', json.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. Login (Staff)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('staffToken', json.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "3. Get All Warehouses (Admin Only - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Verify items array', function () { pm.expect(json.items).to.be.an('array'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "warehouses"] }
      }
    },
    {
      "name": "4. Create Warehouse - Happy Path (Admin - expect 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "var res = pm.response.json();",
              "pm.collectionVariables.set('warehouseId', res.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kho test Postman A\",\n  \"code\": \"WH-PST-A\",\n  \"address\": \"123 Duong Postman, Hai Phong\",\n  \"warehouseType\": \"DOMESTIC\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "warehouses"] }
      }
    },
    {
      "name": "5. Create Warehouse - Duplicate Code (Admin - expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "var res = pm.response.json();",
              "pm.test('Verify duplicate message', function () { pm.expect(res.message).to.contain('đã tồn tại'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kho test Trung Code\",\n  \"code\": \"WH-PST-A\",\n  \"address\": \"123 St\",\n  \"warehouseType\": \"DOMESTIC\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "warehouses"] }
      }
    },
    {
      "name": "6. Update Warehouse - Happy Path (Admin - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var res = pm.response.json();",
              "pm.test('Verify name updated', function () { pm.expect(res.name).to.eql('Kho test Postman A Edited'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kho test Postman A Edited\",\n  \"code\": \"WH-PST-A-EDITED\",\n  \"address\": \"123 Duong Postman, Hai Phong\",\n  \"warehouseType\": \"DOMESTIC\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "{{warehouseId}}"] }
      }
    },
    {
      "name": "7. Create Location - Happy Path (Admin - expect 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "var res = pm.response.json();",
              "pm.collectionVariables.set('locationId', res.locationId);",
              "pm.test('Verify hierarchy resolution', function () {",
              "  pm.expect(res.binCode).to.eql('BIN-PST-01');",
              "  pm.expect(res.shelfCode).to.eql('SHELF-PST');",
              "  pm.expect(res.zoneName).to.eql('Zone Postman');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zoneName\": \"Zone Postman\",\n  \"shelfCode\": \"SHELF-PST\",\n  \"binCode\": \"BIN-PST-01\",\n  \"maxVolume\": 250,\n  \"maxWeight\": 1200,\n  \"isActive\": true,\n  \"note\": \"O ke test Postman\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses/{{warehouseId}}/locations", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "{{warehouseId}}", "locations"] }
      }
    },
    {
      "name": "8. Create Location - Duplicate Code (Admin - expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "var res = pm.response.json();",
              "pm.test('Verify unique bin code message', function () { pm.expect(res.message).to.contain('đã tồn tại'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zoneName\": \"Zone Postman\",\n  \"shelfCode\": \"SHELF-PST\",\n  \"binCode\": \"BIN-PST-01\",\n  \"maxVolume\": 100,\n  \"maxWeight\": 500,\n  \"isActive\": true,\n  \"note\": \"Duplicate location\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses/{{warehouseId}}/locations", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "{{warehouseId}}", "locations"] }
      }
    },
    {
      "name": "9. Update Location - Happy Path (Admin - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var res = pm.response.json();",
              "pm.test('Verify edited fields', function () { pm.expect(res.binCode).to.eql('BIN-PST-01-EDITED'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zoneName\": \"Zone Postman\",\n  \"shelfCode\": \"SHELF-PST\",\n  \"binCode\": \"BIN-PST-01-EDITED\",\n  \"maxVolume\": 350,\n  \"maxWeight\": 1800,\n  \"isActive\": true,\n  \"note\": \"Standard test bin edited\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouse-locations/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouse-locations", "{{locationId}}"] }
      }
    },
    {
      "name": "10. Get Active Warehouses (Authenticated - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var res = pm.response.json();",
              "pm.test('Verify only active warehouses', function () {",
              "  var allActive = res.items.every(w => w.isActive === true);",
              "  pm.expect(allActive).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/warehouses/active", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "active"] }
      }
    },
    {
      "name": "11. Get Active Locations (Authenticated - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var res = pm.response.json();",
              "pm.test('Verify only active locations', function () {",
              "  var allActive = res.items.every(l => l.isActive === true);",
              "  pm.expect(allActive).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/warehouses/{{warehouseId}}/locations/active", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "{{warehouseId}}", "locations", "active"] }
      }
    },
    {
      "name": "12. Staff Action Forbidden (expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 403 Forbidden', function () { pm.response.to.have.status(403); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Warehouse By Staff\",\n  \"code\": \"WH-STF-01\",\n  \"address\": \"St\",\n  \"warehouseType\": \"DOMESTIC\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/warehouses", "host": ["{{baseUrl}}"], "path": ["api", "warehouses"] }
      }
    },
    {
      "name": "13. Delete Location - Happy Path (Admin - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/warehouse-locations/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouse-locations", "{{locationId}}"] }
      }
    },
    {
      "name": "14. Delete Warehouse - Happy Path (Admin - expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouses", "{{warehouseId}}"] }
      }
    }
  ]
}
