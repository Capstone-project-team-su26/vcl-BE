{
	"info": {
		"_postman_id": "4efd2a6a-d8c7-4eb2-8b43-9828fa6b6f88",
		"name": "VCL - Parcel Quotation API",
		"description": "Postman Collection for testing Parcel-Based Quotation features: estimating quotation, sending quotation, and viewing quotation by Order ID or Quotation ID.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"customerToken\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"customer@vcl.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login Admin / Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"accessToken\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@vcl.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Quotation",
			"item": [
				{
					"name": "Tạo báo giá tạm tính (Estimate)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.quotationId) {",
									"    pm.globals.set(\"quotationId\", jsonData.data.quotationId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"serviceType\": \"Express\",\n    \"weightKg\": 5.5,\n    \"volumeM3\": 0.02,\n    \"packageCount\": 1,\n    \"declaredValue\": 1000000\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders/{{orderId}}/quotation/estimate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"{{orderId}}",
								"quotation",
								"estimate"
							]
						},
						"description": "Tạo báo giá tạm tính dựa trên cân nặng/kích thước gửi kèm trong body hoặc dựa trên thông số items nếu bỏ trống body. Nếu có kiện hàng (parcels) trong DB, hệ thống sẽ tự động tính theo từng kiện hàng."
					},
					"response": []
				},
				{
					"name": "Lấy báo giá mới nhất theo Order ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/orders/{{orderId}}/quotation",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"{{orderId}}",
								"quotation"
							]
						},
						"description": "Xem thông tin báo giá mới nhất của đơn hàng bằng Order ID, trả về danh sách kiện hàng parcels chi tiết."
					},
					"response": []
				},
				{
					"name": "Lấy báo giá chi tiết theo Quotation ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/quotations/{{quotationId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"quotations",
								"{{quotationId}}"
							]
						},
						"description": "Xem thông tin báo giá chi tiết bằng Quotation ID, trả về thông tin tính cước theo từng kiện hàng."
					},
					"response": []
				}
			]
		},
