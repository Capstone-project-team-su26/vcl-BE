{
	"info": {
		"_postman_id": "8b52f9c8-4723-4560-bf4f-561bcfdf1efc",
		"name": "VCL Put-Away Feature Test API",
		"description": "Focused Postman Collection for testing the newly created Put-Away feature (Nhập kiện vào vị trí kho). Includes Staff Login, Check-in Parcel, Get Pending Put-away list, and the Put-away API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login as Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.token) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"staff@vcl-system.com\",\n  \"password\": \"Password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Parcels & Warehouse (Staff)",
			"item": [
				{
					"name": "1. Check-in Parcel",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingCode\": \"VCL-20260616235959-123456\",\n  \"actualWeight\": 3.5,\n  \"length\": 40,\n  \"width\": 30,\n  \"height\": 20\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/parcels/check-in",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"check-in"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Get Pending Put-away Parcels",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parcels/pending-putaway?pageNumber=1&pageSize=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"pending-putaway"
							],
							"query": [
								{
									"key": "pageNumber",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "10"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "3. Put-away Parcel (Newly Created API)",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"zoneId\": \"{{zoneId}}\",\n  \"shelfId\": \"{{shelfId}}\",\n  \"binId\": \"{{binId}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/parcels/{{parcelId}}/put-away",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"{{parcelId}}",
								"put-away"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"auth": {
