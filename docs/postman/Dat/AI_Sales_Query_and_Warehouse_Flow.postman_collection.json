		{
			"name": "3. Warehouse Flow (Check-in -> Put-away -> Auto Inventory)",
			"item": [
				{
					"name": "1. Check-in Kiện hàng (Status: RECEIVED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.packageCode) {",
									"    pm.collectionVariables.set(\"packageCode\", jsonData.packageCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingCode\": \"VCL-20260721145629\",\n  \"actualWeight\": 2.5,\n  \"length\": 30,\n  \"width\": 20,\n  \"height\": 15\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/parcels/check-in",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"check-in"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Xem chi tiết kiện hàng (Kèm hasInventory)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parcels/{{parcelId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"{{parcelId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "3. Put-away Kiện hàng (Auto-create Inventory & Status WAREHOUSE_RECEIVED)",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"zoneId\": \"{{zoneId}}\",\n  \"shelfId\": \"{{shelfId}}\",\n  \"binId\": \"{{binId}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/parcels/{{parcelId}}/put-away",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"parcels",
								"{{parcelId}}",
								"put-away"
							]
						}
					},
					"response": []
				},
				{
					"name": "4. Verify Inventory Idempotent API",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventories/from-parcel/{{parcelId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"inventories",
								"from-parcel",
								"{{parcelId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "5. Xem chi tiết đơn ký gửi (Check Order Status WAREHOUSE_RECEIVED)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{orderId}}"
							]
						}
					},
					"response": []
				}
			]
		}
