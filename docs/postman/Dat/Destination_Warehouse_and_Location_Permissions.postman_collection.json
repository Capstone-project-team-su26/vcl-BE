									"if (jsonData && jsonData.token) {",
									"    pm.collectionVariables.set(\"saleToken\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"sale@vcl-system.com\",\n  \"password\": \"Password123\"\n}",
							"options": {
