        "body": {
          "mode": "raw",
          "raw": "{\n  \"receiverName\": \"Nguyen Van A\",\n  \"receiverPhone\": \"0987654321\",\n  \"deliveryAddress\": \"123 Le Loi, HCM\",\n  \"items\": [\n    {\n      \"inventoryId\": \"{{inventoryId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/warehouse-release-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "warehouse-release-requests"]
        }
      }
    },
    {
      "name": "5. Update Status - Customer (expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 403 Forbidden', function () { pm.response.to.have.status(403); });",
              "var res = pm.response.json();",
              "pm.test('Verify msg', function () { pm.expect(res.message).to.contain('Bạn không có quyền'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/warehouse-release-requests/{{wroId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "warehouse-release-requests", "{{wroId}}", "status"]
        }
      }
    },
