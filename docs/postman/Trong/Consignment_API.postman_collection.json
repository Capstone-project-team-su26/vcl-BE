    {
      "name": "2. Tao yeu cau ky gui (+ bao gia tu dong)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "var data = json.data;",
              "pm.test('Co orderId', function () { pm.expect(data).to.have.property('orderId'); });",
              "pm.test('Status = PENDING_REVIEW', function () { pm.expect(data.status).to.eql('PENDING_REVIEW'); });",
              "pm.test('Co bao gia tam tinh', function () { pm.expect(data.quotation).to.have.property('totalEstimatedCost'); });",
              "pm.test('Co customerId va userId', function () { pm.expect(data).to.have.property('customerId'); pm.expect(data).to.have.property('userId'); });",
              "pm.test('Co route va requiresInspection', function () { pm.expect(data.route).to.eql('TQ-VN'); pm.expect(data.requiresInspection).to.eql(true); });",
              "if (data && data.orderId) { pm.collectionVariables.set('orderId', data.orderId); }",
              "if (data && data.quotation && data.quotation.quotationId) { pm.collectionVariables.set('quotationId', data.quotation.quotationId); }",
              "console.log('orderId:', pm.collectionVariables.get('orderId'));",
              "console.log('quotationId:', pm.collectionVariables.get('quotationId'));",
              "console.log('Tong chi phi du kien:', data.quotation ? data.quotation.totalEstimatedCost : 'N/A');",
              "console.log('Warnings (hang han che):', JSON.stringify(data.warnings));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"route\": \"TQ-VN\",\n  \"shippingOption\": \"Express\",\n  \"receiverName\": \"Nguyen Van A\",\n  \"receiverPhone\": \"0901234567\",\n  \"receiverAddress\": \"123 Le Loi, Quan 1, TP.HCM\",\n  \"requiresInspection\": true,\n  \"note\": \"Hang de vo, xu ly can than\",\n  \"items\": [\n    {\n      \"productName\": \"Den LED trang tri\",\n      \"productType\": \"Electronics\",\n      \"quantity\": 10,\n      \"weight\": 2.5,\n      \"width\": 20,\n      \"height\": 15,\n      \"length\": 30,\n      \"declaredValue\": 1500000,\n      \"referenceUrl\": \"https://item.taobao.com/item.htm?id=123456\",\n      \"domesticTrackingCode\": \"SF1234567890\"\n    },\n    {\n      \"productName\": \"Vo dien thoai silicon\",\n      \"productType\": \"Accessories\",\n      \"quantity\": 50,\n      \"weight\": 0.05,\n      \"width\": 8,\n      \"height\": 2,\n      \"length\": 16,\n      \"declaredValue\": 500000,\n      \"referenceUrl\": \"https://detail.1688.com/offer/987654.html\",\n      \"domesticTrackingCode\": null\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/consignments", "host": ["{{baseUrl}}"], "path": ["api", "orders", "consignments"] }
