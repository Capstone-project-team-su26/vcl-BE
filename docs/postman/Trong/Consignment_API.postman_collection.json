          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.test('Dung orderId', function () { pm.expect(data.orderId).to.eql(pm.collectionVariables.get('orderId')); });",
              "pm.test('Co thong tin khach (email/phone)', function () { pm.expect(data.customer).to.have.property('email'); pm.expect(data.customer).to.have.property('phone'); });",
              "pm.test('Co danh sach mat hang', function () { pm.expect(data.items).to.be.an('array').that.is.not.empty; });",
              "pm.test('Item co quantity/referenceUrl/domesticTrackingCode', function () { var i = data.items[0]; pm.expect(i).to.have.property('quantity'); pm.expect(i).to.have.property('referenceUrl'); pm.expect(i).to.have.property('domesticTrackingCode'); });",
              "console.log('Status don:', data.status, '| So mat hang:', data.items.length, '| Bao gia:', data.quotation ? data.quotation.totalEstimatedCost : 'chua co');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
