    {
      "name": "0b. Setup - Login Admin (lay adminToken)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('adminToken', json.token); console.log('adminToken saved'); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "0c. Setup - Tao PricingRule (TQ-VN/Express)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tao moi (201) hoac da ton tai (400)', function () { pm.expect([201, 400]).to.include(pm.response.code); });",
              "console.log('PricingRule TQ-VN/Express:', pm.response.code === 201 ? 'da tao' : 'da ton tai tu truoc');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ruleName\": \"Phụ phí kiểm hàng\",\n  \"ruleCode\": \"SUR_INSPECTION\",\n  \"ruleType\": \"INSPECTION\",\n  \"conditionType\": \"REQUIRES_INSPECTION\",\n  \"calculationType\": \"FIXED\",\n  \"value\": 50000,\n  \"isRequired\": false,\n  \"status\": \"ACTIVE\",\n  \"description\": \"Phụ phí kiểm hàng 50k cố định\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/pricing-rules", "host": ["{{baseUrl}}"], "path": ["api", "pricing-rules"] }
      }
    },
    {
      "name": "1. Login (Customer) - lay JWT token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "    console.log('Token saved:', json.token.substring(0, 20) + '...');",
              "} else {",
              "    console.log('Khong tim thay token trong response:', JSON.stringify(json));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
