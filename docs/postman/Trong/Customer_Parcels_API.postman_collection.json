{
  "info": {
    "name": "VCL - Customer tra cuu kien hang (Customer Parcels)",
    "description": "VCL-90: Customer xem danh sach kien hang thuoc yeu cau ky gui cua minh (sau khi kho check-in / put-away). Endpoint GET /api/customer/parcels. Ho tro loc theo consignmentCode + tim theo searchCode (ma kien).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7237", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "customerEmail", "value": "buidinhtrong912@gmail.com", "type": "string" },
    { "key": "customerPassword", "value": "trong123", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (Customer)",
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
        "var json = pm.response.json(); if (json.token) { pm.collectionVariables.set('token', json.token); }"
      ], "type": "text/javascript" } } ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. Tra cuu kien hang cua minh",
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
        "var data = pm.response.json().data;",
        "pm.test('data la mang', function () { pm.expect(data).to.be.an('array'); });",
        "if (data.length) { var p = data[0]; pm.expect(p).to.have.property('packageCode'); pm.expect(p).to.have.property('packageStatus'); pm.expect(p).to.have.property('consignmentCode'); pm.expect(p.items).to.be.an('array'); }",
        "console.log('So kien:', data.length);"
      ], "type": "text/javascript" } } ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/customer/parcels",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "parcels"],
          "query": [
            { "key": "consignmentCode", "value": "", "disabled": true },
            { "key": "searchCode", "value": "", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "3. Tim theo ma kien (searchCode)",
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
        "pm.test('data la mang', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
      ], "type": "text/javascript" } } ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/customer/parcels?searchCode=PCL",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customer", "parcels"],
          "query": [{ "key": "searchCode", "value": "PCL" }]
        }
      }
    },
    {
      "name": "4. (Negative) Khong co token -> 401",
      "event": [ { "listen": "test", "script": { "exec": ["pm.test('Status 401', function () { pm.response.to.have.status(401); });"], "type": "text/javascript" } } ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/customer/parcels", "host": ["{{baseUrl}}"], "path": ["api", "customer", "parcels"] }
      }
    }
  ]
}
