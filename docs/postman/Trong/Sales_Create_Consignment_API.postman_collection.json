{
  "info": {
    "name": "VCL - Sales tao yeu cau ky gui thay khach (Sales Create Consignment)",
    "description": "Test luong BE: Sales tao yeu cau ky gui thay Customer. Bao gom: login lay token, seed data, tao nhan vien Sales, Sales tao ky gui thanh cong, validate hang cam (400), chan role Customer (403), loi khong tim thay Customer (404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7237", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "salesToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0a. Setup - Seed Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/Test/seed-admin", "host": ["{{baseUrl}}"], "path": ["api", "Test", "seed-admin"] }
      }
    },
    {
      "name": "0b. Setup - Login Admin (lay adminToken)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('adminToken', json.token); console.log('adminToken saved'); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "0c. Setup - Seed Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/Test/seed-customer", "host": ["{{baseUrl}}"], "path": ["api", "Test", "seed-customer"] }
      }
    },
    {
      "name": "0d. Setup - Create Sales Staff (Sale role)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created hoặc 409 Conflict', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test Sale Staff\",\n  \"email\": \"sale@test.com\",\n  \"password\": \"SalePassword123\",\n  \"phone\": \"0988888888\",\n  \"role\": \"Sale\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/User", "host": ["{{baseUrl}}"], "path": ["api", "User"] }
      }
    },
    {
      "name": "0e. Setup - Login Sales Staff (lay salesToken)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('salesToken', json.token); console.log('salesToken saved'); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"sale@test.com\",\n  \"password\": \"SalePassword123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "0f. Setup - Login Customer (lay customerToken)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('customerToken', json.token); console.log('customerToken saved'); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"Customer123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "1. Sales tao yeu cau ky gui thay khach (Happy Path - search email)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Co message thanh cong', function () { pm.expect(json.message).to.include('thành công'); });",
              "var data = json.data;",
              "pm.test('Tra ve orderId', function () { pm.expect(data).to.have.property('orderId'); });",
              "pm.test('Co quotation di kem', function () { pm.expect(data).to.have.property('quotation'); });",
              "if (data.orderId) { pm.collectionVariables.set('orderId', data.orderId); }",
              "console.log('Order created by Sales! Order ID:', data.orderId, '| Status:', data.status);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{salesToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"customer@test.com\",\n  \"route\": \"TQ-VN\",\n  \"shippingOption\": \"Express\",\n  \"receiverName\": \"Nguyen Van B\",\n  \"receiverPhone\": \"0987654321\",\n  \"receiverAddress\": \"123 Nguyen Trai, Q5, HCMC\",\n  \"requiresInspection\": true,\n  \"note\": \"Sales tao ho tai quay\",\n  \"items\": [\n    {\n      \"productName\": \"Ao thun cotton\",\n      \"productType\": \"Clothing\",\n      \"quantity\": 5,\n      \"weight\": 0.2,\n      \"width\": 20,\n      \"height\": 15,\n      \"length\": 5,\n      \"declaredValue\": 500000\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/staff/consignments", "host": ["{{baseUrl}}"], "path": ["api", "staff", "consignments"] }
      }
    },
    {
      "name": "2. Sales tao yeu cau ky gui thay khach (Happy Path - search phone)",
      "event": [
