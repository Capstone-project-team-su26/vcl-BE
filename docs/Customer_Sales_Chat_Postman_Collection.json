				{
					"name": "Send Message",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{salesToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Chào anh, tôi đã tiếp nhận yêu cầu. Lô hàng của anh dự kiến về kho vào ngày mai.\",\n    \"attachmentUrl\": \"https://cloudinary.com/vcl/invoice.pdf\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"conversations",
								"{{conversationId}}",
								"messages"
							]
						},
						"description": "Send a text or attachment message. If a Sales staff replies to an unassigned chat, it assigns them automatically."
					},
					"response": []
				},
				{
					"name": "Mark Messages As Read",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
