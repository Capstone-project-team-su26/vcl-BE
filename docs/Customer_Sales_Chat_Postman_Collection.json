		{
			"name": "Chat REST APIs",
			"item": [
				{
					"name": "Create Conversation (Customer Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.environment.set(\"conversationId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"relatedType\": \"CONSIGNMENT\",\n    \"relatedId\": \"12345678-1234-1234-1234-1234567890ab\",\n    \"message\": \"Xin chào, tôi muốn hỏi về trạng thái vận chuyển của lô hàng này.\",\n    \"attachmentUrl\": null\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/conversations",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"conversations"
							]
						},
						"description": "Customer starts a new conversation room. relatedType and relatedId are optional. message is required."
					},
					"response": []
				},
