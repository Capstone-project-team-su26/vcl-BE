									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/conversations/{{conversationId}}/read",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"conversations",
								"{{conversationId}}",
								"read"
							]
						},
						"description": "Mark all messages from the counter-party in this conversation as read."
					},
					"response": []
				}
			]
		},
		{
			"name": "SignalR Websocket Guide",
			"item": [],
			"description": "To test real-time chat in Postman:\n\n1. In Postman, click **New** -> **WebSocket Request**.\n2. Set the URL to: `ws://localhost:5169/chatHub?access_token={{customerToken}}` (change port to match backend).\n3. Click **Connect**.\n4. Once connected, send a handshake message to format communications (ASP.NET Core SignalR uses JSON protocol ending with ASCII 0x1E record separator):\n   - Send exact string: `{\"protocol\":\"json\",\"version\":1}` (Note: the last character is ASCII record separator 0x1E, copy it precisely).\n5. Join a conversation group by sending:\n   - Send exact string: `{\"arguments\":[\"{{conversationId}}\"],\"invocationId\":\"0\",\"target\":\"JoinConversation\",\"type\":1}`\n6. When you send messages via the REST API POST `/messages` or another WebSocket client, you will receive real-time JSON frames matching the `ReceiveMessage` method!"
		}
	],
