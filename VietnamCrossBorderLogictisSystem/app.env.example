# Mẫu cấu hình app cho container API (file thật tên là app.env).
# Trên server: workflow Deploy tự sinh app.env từ các GitHub secret, đừng sửa tay.
# Trên máy dev: copy thành app.env rồi điền giá trị thật.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnection=

JWT__SecretKey=
JWT__ValidIssuer=vcl-system
JWT__ValidAudience=vcl-clients
JWT__TokenValidityInMinutes=240

MailSettings__Host=smtp.gmail.com
MailSettings__Port=587
MailSettings__SenderEmail=
MailSettings__SenderName=VCL System
MailSettings__Username=
MailSettings__Password=
MailSettings__UseSsl=false

SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__EnableSsl=true
SmtpSettings__Username=
SmtpSettings__Password=

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=https://logictic.site/payment/success
PayOS__CancelUrl=https://logictic.site/payment/cancel

SePay__AccountNumber=
SePay__BankName=mbbank
SePay__AccountName=
SePay__WebhookSecret=
# Tuỳ chọn: SePayService còn đọc SePay:ApiKey để check header Authorization.
# Hiện không set ở đâu nên chỉ xác thực bằng HMAC của WebhookSecret.
# SePay__ApiKey=
SePay__ReturnUrl=https://logictic.site/payment/success
SePay__CancelUrl=https://logictic.site/payment/cancel
# Khác nhau theo từng server, workflow tự đặt
SePay__BaseUrl=

GHNSettings__ApiUrl=https://online-gateway.ghn.vn/shiip/public-api/v2/
GHNSettings__Token=
GHNSettings__ShopId=
GHNSettings__MaxInsuranceValue=5000000
# Khác nhau theo từng server, workflow tự đặt
GHNSettings__WebhookUrl=

GoshipSettings__ApiUrl=https://sandbox.goship.io/api/v2/
GoshipSettings__ClientId=
GoshipSettings__ClientSecret=
GoshipSettings__Token=

# File .env (cạnh docker-compose.yml) là chỗ khác, chỉ chứa 3 biến cho compose:
# IMAGE, API_PORT, TRAEFIK_ROUTER_RULE
