{
	"info": {
		"_postman_id": "7a35f299-d41a-47fa-8027-b50a0076a4df",
		"name": "VCL - Consignment Notification Test",
		"description": "Postman collection to test the consignment status update notifications and customer cancellation API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Setup & Authentication",
			"item": [
				{
					"name": "Seed Staff",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Test/seed-staff",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Test",
								"seed-staff"
							]
						},
						"description": "Seeds the default staff account: staff@employee.com / Employee123"
					},
					"response": []
				},
				{
					"name": "Seed Customer",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Test/seed-customer",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Test",
								"seed-customer"
							]
						},
						"description": "Seeds the default customer account: customer@test.com / Customer123"
					},
					"response": []
				},
				{
					"name": "Login Staff",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"staffToken\", jsonData.token);",
									"    console.log(\"Saved staffToken to environment.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"staff@employee.com\",\n    \"password\": \"Employee123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"customerToken\", jsonData.token);",
									"    console.log(\"Saved customerToken to environment.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"customer@test.com\",\n    \"password\": \"Customer123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Consignments",
			"item": [
				{
					"name": "Get Customer Consignments",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var response = pm.response.json();",
									"if (response.data && response.data.items && response.data.items.length > 0) {",
									"    pm.environment.set(\"orderId\", response.data.items[0].orderId);",
									"    console.log(\"Saved orderId \" + response.data.items[0].orderId + \" to environment.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/orders/consignments?pageNumber=1&pageSize=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"consignments"
							],
							"query": [
								{
									"key": "pageNumber",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "10"
								}
							]
						},
						"description": "Lists the consignments for the customer. Sets orderId automatically to the first consignment in the list."
					},
					"response": []
				},
				{
					"name": "Staff Update Status (APPROVED)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{staffToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"APPROVED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{orderId}}",
								"status"
							]
						},
						"description": "Staff approves the consignment. Generates a notification for the customer."
					},
					"response": []
				},
				{
					"name": "Staff Update Status (REJECTED)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{staffToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"REJECTED\",\n    \"rejectionReason\": \"Hàng hóa chứa vật phẩm cấm bay (pin lithium)\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{orderId}}",
								"status"
							]
						},
						"description": "Staff rejects the consignment request. Generates a notification for the customer with the rejection reason."
					},
					"response": []
				},
				{
					"name": "Customer Cancel Consignment",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cancelReason\": \"Thay đổi kế hoạch gửi hàng, không muốn ký gửi nữa\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders/consignments/{{orderId}}/cancel",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders",
								"consignments",
								"{{orderId}}",
								"cancel"
							]
						},
						"description": "Customer cancels their consignment. Generates a notification for the customer."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5209",
			"type": "string"
		}
	]
}
